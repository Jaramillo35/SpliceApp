# splice-nicegui — the migrated NiceGUI surface in a container.
# Build context is the repo root:  docker build -f Dockerfile.nicegui -t splice-nicegui .
#
# Runs alongside the Streamlit image during the migration; both mount the
# same /data volume, so the SECR database and health baselines are shared.

FROM python:3.12-slim AS builder
WORKDIR /app
COPY requirements.txt requirements-nicegui.txt ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir -r requirements-nicegui.txt

FROM python:3.12-slim AS runtime
# Stamped by the build so a running container can say what it is. Compose
# passes these from the launcher scripts; a bare `docker build` leaves them
# "unknown", which the version page reports honestly rather than guessing.
ARG GIT_SHA=unknown
ARG GIT_BRANCH=unknown
ARG BUILD_DATE=unknown
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    SPLICE_DATA_DIR=/data \
    SPLICE_NICEGUI_PORT=8504 \
    SPLICE_GIT_SHA=$GIT_SHA \
    SPLICE_GIT_BRANCH=$GIT_BRANCH \
    SPLICE_BUILD_DATE=$BUILD_DATE

RUN useradd --create-home --uid 10001 appuser \
 && mkdir -p /data && chown appuser:appuser /data
WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY app.py feedback_system.py CHANGELOG.md ./
COPY nicegui_app ./nicegui_app
COPY pages ./pages
COPY ui ./ui
COPY splice ./splice
COPY secrdb ./secrdb
COPY assets ./assets
COPY vbom_legacy ./vbom_legacy

USER appuser
EXPOSE 8504
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8504/',timeout=2).status==200 else 1)"

CMD ["python", "-m", "nicegui_app"]
