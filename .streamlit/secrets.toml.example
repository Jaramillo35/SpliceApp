# Copy to .streamlit/secrets.toml and fill with real values in deployment.
# Do not commit actual credentials.

# Optional admin token to protect the metrics dashboard page.
METRICS_ADMIN_TOKEN = "replace-with-strong-random-token"

# Optional GitHub sync settings for persisting tickets and metrics JSON from Streamlit Cloud.
# These can also live under a [github] section.
# GITHUB_REPOSITORY = "Jaramillo35/SpliceApp"
# GITHUB_TOKEN = "github_pat_or_fine_grained_token"
# GITHUB_BRANCH = "main"
# METRICS_GITHUB_PATH = "data/impact_metrics.json"
# TICKETS_GITHUB_PATH = "data/tickets.json"

# Optional commit/version override (normally provided by deployment platform).
# GIT_COMMIT_SHA = ""
